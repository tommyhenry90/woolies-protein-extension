{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woolies-protein-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "235c7691a13b095e9011e7a8d7c0d03e",
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "gainsgrocer.com", "custom_domain": true },
    { "pattern": "www.gainsgrocer.com", "custom_domain": true }
  ]
  // After deploy, set the shared session cookie (and rotate every few days):
  //   wrangler secret put WOOLIES_COOKIE
}
